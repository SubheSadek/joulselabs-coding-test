{% extends "layouts/base.html.twig" %}

{% block content %}
<h2>Sell a New Product</h2>

{% if custom_errors is defined %}
    {% for error in custom_errors %}
        <div class="alert alert-danger mb-1">{{ error }}</div>
    {% endfor %}
{% endif %}

<form action="/products/add" method="POST" enctype="multipart/form-data">
    <div class="mb-3">
        <label>Title</label>
        <input type="text" name="title" class="form-control" required value="{{ old.title }}">
        {% if errors.title is defined %}
            <small style="color:red">{{ errors.title[0] }}</small>
        {% endif %}
    </div>

    <div class="mb-3">
        <label>Price ($)</label>
        <input type="number" step="0.01" name="price" class="form-control" required value="{{ old.price }}">
        {% if errors.price is defined %}
            <small style="color:red">{{ errors.price[0] }}</small>
        {% endif %}
    </div>
    <div class="mb-3">
        <label>Cover Image</label>
        <input type="file" name="image" class="form-control" accept="image/*">
        {% if errors.image is defined %}
            <small style="color:red">{{ errors.image[0] }}</small>
        {% endif %}
    </div>
    <div class="mb-3">
        <label>Product File (content to sell)</label>
        <input type="file" name="product_file" class="form-control">
        {% if errors.product_file is defined %}
            <small style="color:red">{{ errors.product_file[0] }}</small>
        {% endif %}
    </div>
    <button type="submit" class="btn btn-primary">Create Product</button>
</form>
{% endblock %}
