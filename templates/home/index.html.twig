{% extends "layouts/base.html.twig" %}

{% block title %}Home{% endblock %}

{% block content %}
    <h1>Welcome</h1>
    {% if session.user_id %}
        <p>You are logged in as {{ session.username }}.</p>
    {% else %}
        <a href="/login" class="btn btn-primary">Login</a>
    {% endif %}
{% endblock %}
