{% extends "layouts/base.html.twig" %}

{% block title %}{{ seller.username }}'s Shop{% endblock %}

{% block content %}
<div class="jumbotron">
    <h1>{{ seller.fullname }} <small class="text-muted">(@{{ seller.username }})</small></h1>
    <p>Welcome to my shop.</p>
</div>

<div class="row" id="product-list">
    {% include "public/_products.html.twig" with { products: products } %}
</div>

{% if hasMore %}
<div class="text-center mt-4">
    <button id="load-more"
        class="btn btn-outline-primary"
        data-page="{{ currentPage + 1 }}"
        data-limit="{{ limit }}"
        data-username="{{ seller.username }}"
    >
        Load More
    </button>
</div>
{% endif %}

{% endblock %}

{% block scripts %}
<script>
$(document).ready(function() {

    let loading = false;

    // Load more products
    $('#load-more').on('click', function() {
        if (loading) return;

        const btn = $(this);
        const nextPage = btn.data('page');
        const limit = btn.data('limit');
        const username = btn.data('username');

        loading = true;
        btn.text('Loading...').prop('disabled', true);

        $.ajax({
            url: `/${username}`,
            method: 'GET',
            data: {
                page: nextPage,
                limit: limit,
                ajax: 1
            },
            success: function(html) {

                if (!html || html.trim() === '') {
                    btn.remove();
                    return;
                }

                $('#product-list').append(html);

                btn.data('page', nextPage + 1);
                btn.text('Load More').prop('disabled', false);

                loading = false;
            },
            error: function() {
                alert('Failed to load more products.');
                btn.text('Load More').prop('disabled', false);
                loading = false;
            }
        });
    });

    // Add to cart
    $(document).on('click', '.add-to-cart', function(e) {
        e.preventDefault();

        const btn = $(this);
        const productId = btn.data('id');

        if (btn.prop('disabled')) {
            return;
        }

        btn.prop('disabled', true).text('Adding...');

        $.ajax({
            url: '/cart/add',
            method: 'POST',
            dataType: 'json',
            data: {
                product_id: productId,
                quantity: 1,
                _csrf: window.CSRF_TOKEN
            },
            success: function(response) {
                if (response.status === 'success') {
                    btn.text('Added ✓');

                    if (response.cart_count !== undefined) {
                        $('#cart-count').text(response.cart_count);
                    }

                } else {
                    alert(response.message || 'Failed to add to cart');
                    btn.prop('disabled', false).text('Add to Cart');
                }
            },
            error: function(xhr) {
                
                btn.prop('disabled', false).text('Add to Cart');

                if (xhr.responseJSON && xhr.responseJSON.errors) {
                    alert(formatErrors(xhr.responseJSON.errors));
                    return;
                }

                if (xhr.status === 404 && xhr.responseJSON && xhr.responseJSON.message) {
                    alert(xhr.responseJSON.message);
                    return;
                }

                alert('Something went wrong. Please try again.');
            }
        });
    });

    function formatErrors(errors) {
        let formattedErrors = '';
        for (let key in errors) {
            formattedErrors += `${errors[key]}\n`;
        }
        return formattedErrors;
    }

});
</script>

{% endblock %}
