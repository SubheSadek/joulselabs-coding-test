{% extends "layouts/base.html.twig" %}

{% block title %}Login - SellNow{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <h2>Login</h2>
        
        {% if custom_errors is defined %}
            {% for error in custom_errors %}
                <div class="alert alert-danger mb-1">{{ error }}</div>
            {% endfor %}
        {% endif %}

        <form action="/login" method="POST">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <div class="mb-3">
                <label>Email</label>
                <input type="email" name="email" class="form-control" required value="{{ old['email'] ?? '' }}">
                {% if errors.email is defined %}
                    <small style="color:red">{{ errors.email[0] }}</small>
                {% endif %}
            </div>
            <div class="mb-3">
                <label>Password</label>
                <input type="password" name="password" class="form-control" required value="{{ old['password'] ?? '' }}">
                {% if errors.password is defined %}
                    <small style="color:red">{{ errors.password[0] }}</small>
                {% endif %}
            </div>
            <button type="submit" class="btn btn-primary">Login</button>
        </form>
    </div>
</div>
{% endblock %}
